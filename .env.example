# ============================================================================
# HOUSE OF NINA — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development
# In Vercel, add these under Project Settings > Environment Variables
# ============================================================================

# 1. STRIPE CONFIGURATION
# Frontend Publishable Key (safe for client-side, prefixed with VITE_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Backend Secret Key (used only in /api/ serverless functions, NEVER expose in client)
STRIPE_SECRET_KEY=rk_live_your_stripe_restricted_or_secret_key

# Stripe Webhook Signing Secret (from Stripe Dashboard > Developers > Webhooks)
# E.g. whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# 2. SUPABASE CONFIGURATION
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (safe for frontend queries)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (used ONLY in /api/stripe-webhook to update order payment status)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
